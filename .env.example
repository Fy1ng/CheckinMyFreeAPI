# AnyRouter 安全登录示例. 复制为 .env 并替换占位符, 不要提交真实 .env.
# GitHub Actions 请将配置放入 production Environment secrets, 不读取本机 .env.
# JSON 变量必须使用单行格式. 以下账号名和用户名都是占位符.

CHECKIN_SECURE_MODE=true
DEBUG_MODE=false

# 必填: 在本机生成随机 32 字节并作 base64 编码, 将输出保存为秘密.
# python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# 这里不提供可用密钥; 运行前替换占位符.
CHECKIN_STATE_KEY=replace_with_base64_encoded_random_32_byte_key

# 首次登录/重新登录需要人工接管时必填, 24-512 字符, 与账号密码独立.
# 可自行运行: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 不要将密码放入 URL、日志或通知. 本机 Windows 普通运行不提供远程接管.
CHECKIN_REMOTE_PASSWORD=replace_with_an_independent_random_remote_access_password

# Identity 是 LinuxDo/GitHub 身份别名, 仅含 type 与可选 proxy, 不填第三方密码.
# 此示例固定直连, 避免两个 Provider 的默认代理不同导致共享身份冲突.
# 需要默认代理时将 proxy 改为 default, 并提供 CHECKIN_PROXY_URL.
CHECKIN_IDENTITIES={"linuxdo-main":{"type":"linuxdo","proxy":"direct"}}

# Account 是目标站点账号. id 唯一且稳定; auth.identity 关联上方别名.
# OAuth 必须填写 api_user 或 expected_username 至少一项; 同时填时两项都要匹配.
# expected_username 为目标站点用户名, 不要假定等于第三方昵称.
# OAuth 不能与 email/password/cookies 混用. 不需要从本机导出 Cookie 或 JSON 登录态.
ANYROUTER_ACCOUNTS=[{"id":"anyrouter-main","name":"AnyRouter 主账号","provider":"anyrouter","auth":{"type":"linuxdo","identity":"linuxdo-main"},"expected_username":"your_anyrouter_username"},{"id":"agentrouter-main","name":"AgentRouter 主账号","provider":"agentrouter","auth":{"type":"linuxdo","identity":"linuxdo-main"},"expected_username":"your_agentrouter_username"}]

# GitHub OAuth: Identity.type 与 Account.auth.type 都改为 github, 并使用对应别名.
# 站点必须已支持相应 OAuth 平台. 程序从站点 /api/status 读取 client ID.
# 自定义 Provider 时每个条目必须包含 domain (纯 HTTPS origin), 即使覆盖内置项.
# PROVIDERS={"agentrouter":{"domain":"https://agentrouter.org","use_proxy":true}}
# PROVIDERS={"customrouter":{"domain":"https://custom.example.com","status_path":"/api/status","auth_state_path":"/api/oauth/state","oauth_client_ids":{"linuxdo":"site_registered_client_id"}}}

# 站点邮箱密码登录替代示例 (不与 OAuth 混合; 不填第三方平台密码):
# ANYROUTER_ACCOUNTS=[{"id":"site-password-main","provider":"anyrouter","email":"account@example.com","password":"replace_with_site_password"}]
# 已有 Cookie 配置仍兼容, 新配置无需导出 Cookie:
# ANYROUTER_ACCOUNTS=[{"id":"legacy-main","cookies":{"session":"existing_session"},"api_user":"12345"}]

# 可选代理. Identity/Account 的 proxy 支持 direct、default 或代理 URL.
# 同一 Identity 的代理配置必须完全一致. 相同 URL 不保证订阅节点的出口 IP 固定.
# 需固定出口时使用可保证固定出口的现有代理. 显式 default 或 use_proxy=true 缺代理时会失败.
# CHECKIN_PROXY_URL=http://127.0.0.1:7890
# PROXY_SUBSCRIPTION_URL=https://example.com/sub?token=replace_with_subscription_token
# 订阅脚本默认测试 https://www.google.com/generate_204, 可在脚本运行环境覆盖:
# PROXY_TEST_URL=https://www.google.com/generate_204

# 本地普通浏览器设置. 人工接管必须是 Linux + DISPLAY/Xvfb, 且具备 x11vnc/noVNC/cloudflared.
# CHECKIN_HEADLESS=true
# CHECKIN_HUMANIZE=true
# CHECKIN_WAIT_TIMEOUT_MS=60000
# CHECKIN_MANUAL_LOGIN=false
# CHECKIN_MANUAL_TIMEOUT_SECONDS=600
# CHECKIN_MANUAL_TOTAL_TIMEOUT_SECONDS=1800
# CLOAKBROWSER_BINARY_PATH=/path/to/local/browser
# 安全模式使用 .auth-state 明文工作目录和 .auth-cache/*.enc 加密快照, 不使用旧明文 profile 缓存.
# CHECKIN_STATE_EPOCH 是 GitHub production Environment variable (默认 1), 不在此 .env 生效.
# 轮换密钥时同步递增远端 epoch; 本地需先隔离旧 .auth-cache/*.enc, 再重新登录.

# 可选通知. 远程接管通知仅发送临时地址, 密码预先保存到密码管理器.
# 没有通知渠道时查看本次 Actions 日志. 不要在本地模拟测试配置真实通知密钥.
# EMAIL_USER=sender@example.com
# EMAIL_PASS=replace_with_mail_app_password
# EMAIL_TO=recipient@example.com
# EMAIL_SENDER=
# CUSTOM_SMTP_SERVER=
# DINGDING_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=replace_with_token
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/replace_with_hook
# WEIXIN_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=replace_with_key
# PUSHPLUS_TOKEN=replace_with_token
# SERVERPUSHKEY=replace_with_sendkey
# TELEGRAM_BOT_TOKEN=replace_with_bot_token
# TELEGRAM_CHAT_ID=replace_with_chat_id
# GOTIFY_URL=https://your-gotify-server/message
# GOTIFY_TOKEN=replace_with_token
# GOTIFY_PRIORITY=9
# BARK_KEY=replace_with_key
# BARK_SERVER=https://api.day.app
