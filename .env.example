# WebUI 的账号、站点、身份、代理、通知和定时配置保存在 SQLite 中.
# python -m server 默认不加载 .env; 下方启动变量需由进程环境显式提供.
# 仅兼容 CLI checkin.py 会读取本地 .env. 不提交含真实值的文件.

# WebUI 启动设置. 默认只监听本机, 定时任务在 WebUI 中启用后才运行.
# CHECKIN_WEB_HOST=127.0.0.1
# CHECKIN_WEB_PORT=8765
# CHECKIN_WEB_DATA_DIR=./server-data
# CHECKIN_WEB_KEY_FILE=./server-keys/master.key
# 原始 32 字节密钥文件. 本地首次启动可自动生成, 应独立备份.
# Docker 请先创建密钥并只读挂载, 不能依赖容器启动时写入 /keys.
# 非交互运行推荐从只读文件读取 WebUI 密码, 至少 16 字符.
# CHECKIN_WEB_PASSWORD_FILE=./server-keys/web-password
# 也可显式传 CHECKIN_WEB_PASSWORD, 不建议将其持久化在 .env 或命令历史中.
# 没有密码来源的交互式首次启动会通过 getpass 设置, 数据库只保存密码哈希.
# CHECKIN_AUTH_ROOT=/tmp/checkin-auth
# CHECKIN_WEB_XVFB=true

# 以下为保留的 CLI 配置格式; 不用于 WebUI 的日常保存.
# 可用 uv run --frozen python -m server --import-env .env 显式导入旧配置.
# JSON 使用单行格式. 以下账号名、用户名、密码和地址均为占位符.
CHECKIN_SECURE_MODE=true
DEBUG_MODE=false

# CLI 安全模式使用 base64 编码的随机 32 字节密钥, 与 WebUI 原始密钥文件格式不同.
# python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
CHECKIN_STATE_KEY=replace_with_base64_encoded_random_32_byte_key

# 只供旧 CLI 临时接管流程, 与 WebUI 登录密码独立; WebUI 使用自己的已登录会话.
# 独立 24-512 字符密码, 不写入 URL、日志或通知.
# CHECKIN_REMOTE_PASSWORD=replace_with_an_independent_remote_access_password

# Identity 只存 LinuxDo/GitHub 身份别名、类型和代理策略, 不填第三方密码.
CHECKIN_IDENTITIES={"linuxdo-main":{"type":"linuxdo","proxy":"direct"}}

# OAuth 必须填写 api_user 或 expected_username, 两项同时填写时均须匹配.
# expected_username 是目标站点用户名, 不要假定等于 LinuxDo/GitHub 昵称.
ANYROUTER_ACCOUNTS=[{"id":"anyrouter-main","name":"AnyRouter 主账号","provider":"anyrouter","auth":{"type":"linuxdo","identity":"linuxdo-main"},"expected_username":"your_anyrouter_username"},{"id":"agentrouter-main","name":"AgentRouter 主账号","provider":"agentrouter","auth":{"type":"linuxdo","identity":"linuxdo-main"},"expected_username":"your_agentrouter_username"}]

# GitHub OAuth: Identity.type 和 Account.auth.type 改为 github, 别名一致.
# 自定义站点每项都必须提供纯 HTTPS origin, 即使只是覆盖内置项.
# PROVIDERS={"customrouter":{"domain":"https://custom.example.com","use_proxy":false}}
# 站点密码与 OAuth 互斥, 不填写第三方平台密码:
# ANYROUTER_ACCOUNTS=[{"id":"site-password-main","provider":"anyrouter","email":"account@example.com","password":"replace_with_site_password"}]
# 已有 Cookie 配置兼容, 新配置不需要导出 Cookie:
# ANYROUTER_ACCOUNTS=[{"id":"legacy-main","cookies":{"session":"existing_session"},"api_user":"12345"}]

# 可选现有代理. Identity/Account 支持 direct、default 或代理 URL.
# 同一 Identity 的最终代理必须一致; 相同 URL 不保证上游出口固定.
# CHECKIN_PROXY_URL=http://127.0.0.1:7890
# WebUI 不自动启动 Mihomo 订阅服务. 以下只供原有 CLI 订阅脚本:
# PROXY_SUBSCRIPTION_URL=https://example.com/sub?token=replace_with_subscription_token
# PROXY_TEST_URL=https://www.google.com/generate_204

# 浏览器与人工接管. WebUI 的 Linux 版接管走同一已登录 WebUI, 不创建公网隧道.
# Windows 可管理配置, 已有效登录态可使用 headless; 人工接管需要 Linux + DISPLAY/Xvfb.
# CHECKIN_HEADLESS=true
# CHECKIN_HUMANIZE=true
# CHECKIN_WAIT_TIMEOUT_MS=60000
# CHECKIN_MANUAL_LOGIN=false
# CHECKIN_MANUAL_TIMEOUT_SECONDS=600
# CHECKIN_MANUAL_TOTAL_TIMEOUT_SECONDS=1800
# CLOAKBROWSER_BINARY_PATH=/path/to/local/browser
# CLOAKBROWSER_AUTO_UPDATE=false

# 可选通知. WebUI 内配置即可, CLI 可使用这些变量.
# 不要在本地模拟测试中提供真实通知密钥.
# EMAIL_USER=sender@example.com
# EMAIL_PASS=replace_with_mail_app_password
# EMAIL_TO=recipient@example.com
# EMAIL_SENDER=
# CUSTOM_SMTP_SERVER=
# DINGDING_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=replace_with_token
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/replace_with_hook
# WEIXIN_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=replace_with_key
# PUSHPLUS_TOKEN=replace_with_token
# SERVERPUSHKEY=replace_with_sendkey
# TELEGRAM_BOT_TOKEN=replace_with_bot_token
# TELEGRAM_CHAT_ID=replace_with_chat_id
# GOTIFY_URL=https://your-gotify-server/message
# GOTIFY_TOKEN=replace_with_token
# GOTIFY_PRIORITY=9
# BARK_KEY=replace_with_key
# BARK_SERVER=https://api.day.app

# Fy1Push: 服务地址留空禁用. 使用 HTTPS, 本机测试可用 HTTP loopback.
# 地址仅允许根路径或 /v1/push, 不含凭据, 查询参数或片段.
# FY1PUSH_SERVER=https://push.example.com
# FY1PUSH_TOKEN=replace_with_send_token
# 分组留空默认签到, 允许 1 至 24 个 Unicode 字母, 数字或 -_.
# FY1PUSH_CHANNEL=签到
