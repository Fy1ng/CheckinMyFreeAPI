# Startup variables only. python -m server does not load .env automatically.
# Accounts, credentials, notifications and schedules are configured in the WebUI.
# Never put actual credentials into a tracked file.
# CHECKIN_WEB_HOST=127.0.0.1
# CHECKIN_WEB_PORT=8765
# CHECKIN_WEB_DATA_DIR=./server-data
# CHECKIN_WEB_KEY_FILE=./server-keys/master.key
# CHECKIN_WEB_PASSWORD_FILE=./server-keys/web-password
# The master key is a raw 32-byte file. Back it up separately from data.
# No browser, OAuth, remote desktop or browser profile configuration is used.
